# Direct-chat production profile. Copy to backend/.env and replace secrets.
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_CHAT_API_URL=http://127.0.0.1:11434/api/chat
OLLAMA_CHAT_FALLBACK=true
OLLAMA_MODEL=hf.co/Zkare/Chatbot_Ielts_Assistant_v2:Q4_K_M
OLLAMA_NUM_PREDICT=2800
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_THINK=false
OLLAMA_DIRECT_TEMPERATURE=0.3

CORS_ALLOW_ORIGINS=https://ielts.ptit.store,http://localhost:5173,http://127.0.0.1:5173
API_AUTH_REQUIRED=true
API_AUTH_TOKEN=replace-with-the-same-secret-used-by-the-trusted-frontend-proxy
DEBUG_PAYLOADS=false

DOCUMENT_UPLOAD_ENABLED=false
LAYOUT_ENABLE=false
WARMUP_LLM=true
WARMUP_EMBEDDING=false
WARMUP_OCR=false
WARMUP_LAYOUT=false

UPLOAD_DIR=uploads
RAG_DATA_DIR=data/rag
RAG_SESSION_GRACE_TTL_SECONDS=300
RAG_SESSION_HARD_TTL_SECONDS=1800
RAG_SESSION_MAX_DOCUMENTS=30
RAG_SESSION_MAX_CHUNKS=15000
RAG_SESSION_CACHE_MAX_STORES=4

CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW_SECONDS=600
CHAT_MAX_CONCURRENCY=2
UPLOAD_MAX_CONCURRENCY=1
